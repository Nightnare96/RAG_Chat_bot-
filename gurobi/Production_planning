m = Model("Production_Planning")

x = m.addVar(lb=0, name="P1")
y = m.addVar(lb=0, name="P2")

m.setObjective(40*x + 30*y, GRB.MAXIMIZE)

m.addConstr(2*x + y <= 100, "Machine_Time")
m.addConstr(x <= 40, "Demand_P1")
m.addConstr(y <= 70, "Demand_P2")

m.optimize()

print("\nQ1 Production Planning")
for v in m.getVars():
    print(v.VarName, v.X)
print("Maximum Profit =", m.ObjVal)
